# dependencies
node_modules

# next.js
.next/
# Anchored: an unanchored `out/` or `build` matched ANY folder of that name, so
# a route at app/out/ or app/api/build/ was silently never committed — and the
# build still passed, because nothing imports a route file.
/out/
apps/*/out/

# production
/build
apps/*/build/

# vercel link / vercel pull — project ids and pulled env files, never committed
.vercel

# env
.env
.env.local
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# Helper worktrees (every agent preset runs with isolation: worktree). A nested
# checkout, never content: committing it pushes a gitlink to another branch.
/.claude/worktrees/
