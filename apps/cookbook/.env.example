# Anthropic — server-side only. Five model calls, all in lib/anthropic.ts:
# pricing a recipe, writing one you described, reading one off a link, reading
# one off a photo or PDF, and tidying the shopping list.
# `/api/health` probes for this key's presence and shape, never by calling it.
ANTHROPIC_API_KEY=

# Supabase — the same project every Paddock tool shares. This app reads and
# writes the `cookbook` schema and no other, which lib/supabase.ts pins.
SUPABASE_URL=https://qyclakzsupyxgnqfgpiq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password gate — a bcrypt hash of your chosen password, NOT the plaintext.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# **Paste it straight into Vercel, never into a .env file.** @next/env strips the quotes and
# then expands what is inside, so a bcrypt hash loses everything from its first `$` — 60
# characters become 44, and a correct password is rejected with no error anywhere.
#
# **Escape every `$` in the hash as `\$` when you paste it into .env.local.**
# @next/env strips the quotes and expands anyway, so a 60-character hash becomes
# 44 and every login fails with nothing in the log saying why.
#
# This hash will differ from the other apps' even for the same password, because
# bcrypt salts randomly. That is expected.
APP_PASSWORD_HASH=

# Must be byte-identical across every Paddock app for the shared
# .techpaddock.io session cookie. A mismatch doesn't error — the other apps
# just silently stop accepting a valid session.
SESSION_SECRET=

# Kroger — Send to cart, King Soopers (TEC-90). Server-side only; the token and
# the secret never reach the browser. The app is registered with Kroger in
# Production with the redirect URI https://cookbook.techpaddock.io/kroger/callback,
# so Connect King Soopers only completes on that host.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Encrypts the stored Kroger refresh token (AES-256-GCM): base64 of 32 random
# bytes — generate with `openssl rand -base64 32`. Changing it makes the stored
# token unreadable, and King Soopers must be connected again.
KROGER_TOKEN_KEY=
