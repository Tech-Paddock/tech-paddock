# Supabase — the same project every Paddock tool shares. This app reads and
# writes the `lando` schema and no other, which lib/supabase.ts pins.
# Both values: Supabase dashboard → Project Settings → API. The key is the
# service role key (server-side only; it bypasses RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password gate — a bcrypt hash of the shared password, NOT the plaintext.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# **Paste it straight into Vercel, never into a .env file.** @next/env expands
# what is inside, so a bcrypt hash loses everything from its first `$` and a
# correct password is rejected with no error anywhere.
# For local development only, escape every `$` as `\$` in .env.local.
# It will differ from the other apps' hashes for the same password: bcrypt salts.
APP_PASSWORD_HASH=

# Must be byte-identical across every Paddock app for the shared
# .techpaddock.io session cookie. Copy it from another app's Vercel project;
# do not generate a new one. A mismatch doesn't error — the other apps just
# silently stop accepting a valid session.
SESSION_SECRET=
