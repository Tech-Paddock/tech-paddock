# Supabase — same project shared across every Paddock tool
SUPABASE_URL=https://qyclakzsupyxgnqfgpiq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password gate — a bcrypt hash of your chosen password, NOT the plaintext.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# **Paste it straight into Vercel, never into a .env file.** @next/env strips the quotes and
# then expands what is inside, so a bcrypt hash loses everything from its first `$` — 60
# characters become 44, and a correct password is rejected with no error anywhere.
APP_PASSWORD_HASH=

# Draft-follow-up integration — calls the Message Editor's /api/draft directly.
# INTERNAL_API_SECRET must match the same variable set on the editor app; it's
# how editor's middleware lets this server-to-server call through without a
# browser session cookie.
EDITOR_BASE_URL=https://editor.techpaddock.io
INTERNAL_API_SECRET=

# Must be byte-identical across every Paddock app for the shared .techpaddock.io session cookie
SESSION_SECRET=

# Microsoft Graph — personal Outlook account, so the "consumers" authority
# rather than a tenant id. One registration covers both calendar and To Do:
# scopes offline_access, Calendars.Read, Tasks.ReadWrite. Complete consent once
# and store the refresh token here.
#
# Leaving these unset is fine — the dashboard reports Outlook as not connected
# and every other signal still works.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=

# Optional. The To Do list follow-up tasks are filed under. Created on first
# use. Defaults to "Paddock".
MS_TODO_LIST_NAME=

# Optional. Used to render meeting times server-side; Vercel runs UTC.
# Defaults to America/New_York.
PADDOCK_TIMEZONE=

# Optional. Defaults to https://resume.techpaddock.io — used for deep links
# from the dashboard into render history.
RESUME_BASE_URL=

# Required for the daily stale sweep to run at all. Vercel Cron sends this as a
# bearer token, and middleware.ts waves /api/cron/* past the password gate, so
# this is the only thing guarding the route. The guard fails closed: unset means
# every caller gets 401 and the sweep never runs. Set it before MS_GRAPH_*.
CRON_SECRET=
