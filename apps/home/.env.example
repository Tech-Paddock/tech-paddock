# Hub app — password gate only, no database or model access.

# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# **Paste it straight into Vercel, never into a .env file.** @next/env strips the quotes and
# then expands what is inside, so a bcrypt hash loses everything from its first `$` — 60
# characters become 44, and a correct password is rejected with no error anywhere.
APP_PASSWORD_HASH=

# Must be byte-identical across every Paddock app for the shared .techpaddock.io session cookie
SESSION_SECRET=

# The hub renders its landing glance server-side by asking each tool for a
# roll-up, so it needs the same shared secret the tools use for server-to-server
# calls. Still no database credentials here — the hub reads no schema directly.
INTERNAL_API_SECRET=

# Optional. The Pit Wall's only credential: open pull requests, branches, and each
# project's latest production deployment (the statuses Vercel posts to GitHub).
# Read-only on this repository — Pull requests, Contents and Deployments: read.
# Unset, the Pit Wall says so rather than showing an empty board.
GITHUB_TOKEN=

# Optional. Defaults to https://tracker.techpaddock.io. Empty counts as unset.
TRACKER_BASE_URL=

# VERCEL_TOKEN is no longer read. The Garage flags it if it is still set.
