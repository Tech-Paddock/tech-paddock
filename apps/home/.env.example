# Home — password gate only, no database or model access.

# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# **Paste it straight into Vercel, never into a .env file.** @next/env strips the quotes and
# then expands what is inside, so a bcrypt hash loses everything from its first `$` — 60
# characters become 44, and a correct password is rejected with no error anywhere.
APP_PASSWORD_HASH=

# Must be byte-identical across every Paddock app for the shared .techpaddock.io session cookie
SESSION_SECRET=

# The Pit Wall's only credential: open issues in Linear, team TEC. Create it read-only and
# limited to team TEC — home never writes to Linear. Unset, the Pit Wall says so rather
# than showing an empty board.
LINEAR_API_KEY=

# The Garage's deploy check: each project's latest production deployment, from the statuses
# Vercel posts to GitHub. Read-only on this repository — Deployments: read.
# Unset, The Garage says it could not check rather than reporting nothing wrong.
GITHUB_TOKEN=

# VERCEL_TOKEN and INTERNAL_API_SECRET are no longer read. The Garage flags either if still set.
