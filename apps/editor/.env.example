# Anthropic — server-side only, drafting calls
ANTHROPIC_API_KEY=

# Supabase — same project shared across every Paddock tool
SUPABASE_URL=https://qyclakzsupyxgnqfgpiq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password gate — a bcrypt hash of your chosen password, NOT the plaintext.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
APP_PASSWORD_HASH=

# Lets Pipeline Tracker's draft-follow-up button call /api/draft directly
# (server-to-server, no browser session). Must match the same variable set
# on the tracker app. Generate a random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Must be byte-identical across every Paddock app for the shared .techpaddock.io session cookie
SESSION_SECRET=
