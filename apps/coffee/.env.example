# Anthropic — server-side only. Two calls: reading the bag photo, and
# searching the roaster's site for brewing instructions.
ANTHROPIC_API_KEY=

# Supabase — same project shared across all the Paddock tools
SUPABASE_URL=https://qyclakzsupyxgnqfgpiq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password gate — a bcrypt hash of your chosen password, NOT the plaintext.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# This will differ from the other apps' hashes even for the same password:
# bcrypt salts randomly. That's expected.
APP_PASSWORD_HASH=

# Must be byte-identical across every Paddock app for the shared
# .techpaddock.io session cookie. A mismatch doesn't error — the other apps
# just silently stop accepting a valid session.
SESSION_SECRET=
